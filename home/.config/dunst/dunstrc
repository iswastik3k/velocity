[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 120)
    origin = top-right
    offset = (12, 48)
    scale = 0
    notification_limit = 3

    padding = 12
    horizontal_padding = 14
    separator_height = 1
    separator_color = frame

    frame_width = 2
    frame_color = "#393552"
    gap_size = 6
    corner_radius = 12

    font = JetBrainsMono Nerd Font 11

    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle
    stack_duplicates = true
    show_indicators = no

    icon_position = off
    show_age_threshold = 60
    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/wofi --dmenu
    browser = xdg-open

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#232136"
    foreground = "#e0def4"
    frame_color = "#393552"
    timeout = 4

[urgency_normal]
    background = "#232136"
    foreground = "#e0def4"
    frame_color = "#c4a7e7"
    timeout = 5

[urgency_critical]
    background = "#232136"
    foreground = "#eb6f92"
    frame_color = "#eb6f92"
    timeout = 0
